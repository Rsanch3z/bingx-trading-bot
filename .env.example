# Runtime
DRY_RUN=true
ENVIRONMENT=demo

# BingX API
BINGX_API_KEY=
BINGX_API_SECRET=
BINGX_SANDBOX=true
BINGX_API_BASE_URL=https://open-api-vst.bingx.com

# Manual BingX test order. Keep tiny until the demo order path is verified.
TEST_ORDER_SYMBOL=DOGE/USDT:USDT
TEST_ORDER_NOTIONAL_USDT=5

# Market
SYMBOL=BTC/USDT:USDT
TIMEFRAME=5m
CANDLE_LIMIT=120
LEVERAGE=1

# Capital and risk
STARTING_EQUITY_USDT=10
MAX_RISK_PER_TRADE_PCT=0.02
MAX_KELLY_FRACTION=0.05
MAX_DAILY_LOSS_USDT=2

# Strategy
FAST_EMA=9
SLOW_EMA=21
TAKE_PROFIT_PCT=0.015
STOP_LOSS_PCT=0.0075

# Kelly inputs. Start conservative until real stats accumulate.
ESTIMATED_WIN_RATE=0.50
ESTIMATED_WIN_LOSS_RATIO=1.50

# Journal
TRADE_JOURNAL_PATH=data/trades.csv

# TradingView webhook
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8787
WEBHOOK_SECRET=replace-with-a-long-random-secret

# Enable after Cloudflare Tunnel is live. Local manual tests should keep this false.
ENFORCE_WEBHOOK_IP_ALLOWLIST=false
WEBHOOK_ALLOWED_IPS=52.89.214.238,34.212.75.30,54.218.53.128,52.32.178.7

# Google Cloud Pub/Sub bridge
GCP_PROJECT_ID=
PUBSUB_TOPIC=tradingview-alerts
PUBSUB_SUBSCRIPTION=tradingview-alerts-local-bot
CLOUD_RUN_HOST=0.0.0.0
CLOUD_RUN_PORT=8080
