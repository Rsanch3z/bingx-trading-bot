# BingX API (get from BingX API Management)
BINGX_API_KEY=
BINGX_API_SECRET=

# demo = VST demo account | live = real account
BINGX_MODE=demo
BINGX_SANDBOX=true

# GCP Pub/Sub
PUBSUB_PROJECT_ID=your-gcp-project-id
PUBSUB_SUBSCRIPTION=local-bot-sub
GOOGLE_APPLICATION_CREDENTIALS=./config/service_account.json

# Webhook (choose a random 32-char secret, same value in Cloud Run)
WEBHOOK_SECRET=change_me_to_random_32_char_string

# Risk Management
MAX_DAILY_LOSS_PCT=5.0
MAX_OPEN_POSITIONS=5
MAX_SINGLE_TRADE_PCT=10.0
MONITOR_INTERVAL_SEC=30

# Safety (set false only after demo testing passes)
DRY_RUN=true
